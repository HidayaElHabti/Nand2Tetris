// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    //Mux(a,b,sel) = (sel and b) or (not(sel) and a)
    Not(in= sel, out= nsel);
    And(a= a, b= nsel, out= ansel);
    And(a= sel, b= b, out= bsel);
    Or(a= ansel, b= bsel, out= out);
}