// File name: projects/5/CPU.hdl
/**
 * The Hack Central Processing unit (CPU).
 * Parses the binary code in the instruction input and executes it according to the
 * Hack machine language specification. In the case of a C-instruction, computes the
 * function specified by the instruction. If the instruction specifies to read a memory
 * value, the inM input is expected to contain this value. If the instruction specifies
 * to write a value to the memory, sets the outM output to this value, sets the addressM
 * output to the target address, and asserts the writeM output (when writeM = 0, any
 * value may appear in outM).
 * If the reset input is 0, computes the address of the next instruction and sets the
 * pc output to that value. If the reset input is 1, sets pc to 0.
 * Note: The outM and writeM outputs are combinational: they are affected by the
 * instruction's execution during the current cycle. The addressM and pc outputs are
 * clocked: although they are affected by the instruction's execution, they commit to
 * their new values only in the next cycle.
 */
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    //if C-Instruction: 1xxaccccccdddjjj
    //if a input M else A-register
    Mux16(a= outARegister, b= inM, sel= instruction[12], out= MorARegister);
    //ALU: x = D-Register, y= M or A-Register, control-bits= cccccc, out= outM
    ALU(x= outRegisterD, y= MorARegister, zx= instruction[11], nx= instruction[10], zy= instruction[9], ny= instruction[8], f= instruction[7], no= instruction[6], out= outALU, out= outM, zr= zr, ng= ng);
    //writeM= 1st d if C-Instruction or false if A-instruction
    Mux(a= false, b= instruction[3], sel= instruction[15], out= writeM);
    //loadD = 2nd d if C-Instruction or false if A-instruction
    Mux(a= false, b= instruction[4], sel= instruction[15], out= loadDRegister);
    //loadA = 3rd d if C-Instruction or true if A-instruction
    Mux(a= true, b= instruction[5], sel=  instruction[15], out= loadARegister);
    //jump if (j2&(j1&j0 || ng)) || (j1&zr) || (j0&!ng&!zr)
    And(a= instruction[0], b= instruction[1], out= j1j0); Or(a= j1j0, b= ng, out= j1j0orng);
    And(a= instruction[2], b= j1j0orng, out= jump1);
    And(a= instruction[1], b= zr, out= jump2);
    Not(in= ng, out= nng); Not(in= zr, out= nzr); And(a= nng, b= nzr, out= nngnzr);
    And(a= instruction[0], b= nngnzr, out= jump3);
    Or(a= jump1, b= jump2, out= jump12); Or(a= jump12, b= jump3, out= jump);
    //if A-instruction load instruction into A-register, else load ALU output (if loadARegister)
    Mux16(a= instruction, b= outALU, sel= instruction[15], out= inARegister);
    //A-Register
    ARegister(in= inARegister, load= loadARegister, out= outARegister, out[0..14]= addressM);

    // if C-instruction update PC if jump, else just increment PC
    Mux(a= false, b= jump, sel= instruction[15], out= loadPC);
    //PC
    PC(in= outARegister, load= loadPC, inc= true, reset= reset, out[0..14]= pc);

    //D-Register
    DRegister(in= outALU, load= loadDRegister, out= outRegisterD);
    
}