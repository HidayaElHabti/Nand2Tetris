/**
* Implements a garage door instance.
* The garage door opens and closes using
* up and down arrows.
* The garage door has a height; 
* distance from floor to the door's end, 
* and a speed of its opening and closing.
* The speed is increased by clicking 
* on up and down arrows multiple times.
* The door's color is white and the garage's inside
* is black.
*/

class GarageDoor {
    field int frameWidth; 
    field int height;
    field int speed;
    field boolean open;

    constructor GarageDoor new(int width){
        let frameWidth = width;
        let height = 0;//garage door starts closed
        let speed = 1;//default speed is 1
        return this;
    }

    method void dispose() {
        return;
    }

    method void moveUp() {
        if(~isOpen()){
            if(height < (256-frameWidth-speed)){
                let height = height + speed;
            }
            else {
                let height = 255-frameWidth;
            }
            do Screen.setColor(true);
            do Screen.drawRectangle(frameWidth+1,256-height,511-frameWidth,256);
        }
        return;
    }

    method void moveDown() {
        if(~isClosed()){
            if(height > (speed + 1)) {
                let height = height - speed;
            }
            else {
                let height = 0;
            }
            do Screen.setColor(false);
            do Screen.drawRectangle(frameWidth+1,frameWidth+1,511-frameWidth,256-height);
        }
        return;
    }

    method void incSpeed() {
        let speed = speed + 1;
        return;
    }

    method void decSpeed() {
        if(speed > 1) {//min speed is 1
            let speed = speed - 1;
        }
        return;
    }

    method void resetSpeed() {
        let speed = 1;
        return;
    }

    method boolean isOpen(){
        return (height=(255-frameWidth));
    }

    method boolean isClosed(){
        return (height=0);
    }
}