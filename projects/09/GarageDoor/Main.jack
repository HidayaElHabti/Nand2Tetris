/**
 * The Main class initializes a new Garage and turns it on.
 */
class Main {

    function void main() {
        var Garage garage;
        var int frameWidth;
        let frameWidth = Keyboard.readInt("What is your garage's door frame width?");
        let garage = Garage.new(frameWidth);
        do garage.turnOn();
        //do garage.dispose();
        return;
    }

}